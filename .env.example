# =============================================================================
# Wakeel — environment variables template
# Copy to .env.local for local `wrangler dev` use, OR set each one with:
#   wrangler secret put NAME
# NEVER commit a real .env file. NEVER put secrets in wrangler.toml [vars].
# =============================================================================

APP_NAME=Wakeel
ADMIN_EMAIL=
# Optional comma-separated exact origins only when a frontend is hosted on a different origin.
# Same-origin requests are allowed automatically; development allows localhost only.
CORS_ALLOWED_ORIGINS=

# --- AI Providers (all free-tier, all optional — router skips any that's empty) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Web research ---
# Browser Use Cloud is pay-as-you-go with one-time signup credit, not a guaranteed free API.
# Browser automation uses Cloudflare Browser Run binding from wrangler.toml (no API key).
# Keep the account on Workers Free to avoid paid browser overages.
# Browser acceptance-test credentials (not Worker secrets) are provided only in the test shell;
# see README.md. The test consumes Cloudflare Browser Run minutes.

# --- Supabase Auth ---
# Project URL + public/publishable key only; never put a secret/service_role key in the frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Frontend values are configured in web/.env.local at build time.

# --- Crypto payments: NOWPayments (optional, disabled if empty) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Crypto payments: direct BSC USDT verification (public wallet settings; no private key) ---
TRUST_WALLET_ADDRESS=0x8575DB82A480428Ef0d9eB9b9a62de3453303Fc9
TRUST_WALLET_NETWORK=BSC Mainnet (BEP20)
TRUST_WALLET_TOKEN=USDT (BEP20 / Binance-Peg BSC-USD)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

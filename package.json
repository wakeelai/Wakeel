{
  "name": "wakeel-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_EXTERNAL_INTEGRATION=1 vitest run tests/integration.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply wakeel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wakeel-db --remote",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "hono": "^4.6.3",
    "jose": "^5.9.3"
  }
}
